# m0 = source texture
# m1 = uv
# m2 = frag color

# r0 = accumulator vec4
# r1 = base uv vec2
# r2 = temp uv vec2
# r3 = sampled color vec4
# r4 = offset vec2
# r5 = divisor vec4

# load uv
LOAD m1 2 r1

# top-left
WRITE -0.001f -0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# top
WRITE 0f -0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# top-right
WRITE 0.001f -0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# left
WRITE -0.001f 0f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# center
SAMPLE_TEX2 m0 r1 r3
ADD_VEC4 r0 r3 r0

# right
WRITE 0.001f 0f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# bottom-left
WRITE -0.001f 0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# bottom
WRITE 0f 0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# bottom-right
WRITE 0.001f 0.001f r4
ADD_VEC2 r1 r4 r2
SAMPLE_TEX2 m0 r2 r3
ADD_VEC4 r0 r3 r0

# divide by 9
WRITE 9f 9f 9f 9f r5
DIV_VEC4 r0 r5 r0

# output
STORE r0 4 m2